<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
>
    <testsuites>
        <!-- Default: everything under tests/ except the framework-bridge integration
             tests below (SC#5 entry point: `composer test` / `composer test-unit`). -->
        <testsuite name="unit">
            <directory suffix="Test.php">tests</directory>
            <exclude>tests/LaravelMiddlewareTest.php</exclude>
            <exclude>tests/LaravelAuthMiddlewareTest.php</exclude>
            <exclude>tests/SymfonyAuthSubscriberTest.php</exclude>
            <exclude>tests/SymfonyAuthEdgeSubscriberTest.php</exclude>
            <exclude>tests/LaravelAccessMiddlewareTest.php</exclude>
            <exclude>tests/SymfonyAccessAttributeListenerTest.php</exclude>
            <!-- CONTRACT.md §12 (plan T8 item 2): the Laravel/Symfony "Login with
                 AXIAM" controllers need symfony/http-foundation (require-dev only) —
                 same reasoning as the other framework-bridge exclusions above. -->
            <exclude>tests/LaravelOidcControllerTest.php</exclude>
            <exclude>tests/SymfonyOidcControllerTest.php</exclude>
        </testsuite>
        <!-- Laravel/Symfony bridge tests (wave-5 plans, plus the CONTRACT.md §11
             declarative-authorization listener/middleware) require the dev-only
             illuminate/* and symfony/* packages declared in require-dev. -->
        <testsuite name="integration">
            <directory suffix="MiddlewareTest.php">tests</directory>
            <directory suffix="SubscriberTest.php">tests</directory>
            <!-- Does not match either suffix pattern above (it is a kernel.controller
                 LISTENER, not a middleware/subscriber) but has the exact same
                 dev-only-symfony-package dependency, so it is listed explicitly. -->
            <file>tests/SymfonyAccessAttributeListenerTest.php</file>
            <!-- CONTRACT.md §12 (plan T8 item 2): the "Login with AXIAM" invokable
                 controllers — neither middleware nor subscribers, but the same
                 dev-only-framework-package dependency as everything else here. -->
            <file>tests/LaravelOidcControllerTest.php</file>
            <file>tests/SymfonyOidcControllerTest.php</file>
        </testsuite>
    </testsuites>

    <coverage>
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </coverage>
</phpunit>
