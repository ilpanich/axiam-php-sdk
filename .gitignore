/vendor/
composer.lock
.phpunit.result.cache

# phpDocumentor build cache/output (generated in CI, never committed)
.phpdoc/
_docs_out/

# Coverage report (generated in CI, uploaded to Coveralls)
coverage.xml

# protoc scratch space for `composer grpc-gen` — the stubs it produces are
# relocated into src/Grpc/Gen/ and committed from there.
/build/

# Python bytecode from scripts/gen_management.py — the generator is the source,
# its .pyc is not. A copy of gen_management.cpython-311.pyc was committed once
# by accident; this keeps it from coming back.
__pycache__/
*.pyc
